rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Player-facing reads are public for phone/username login (no OTP).
    // Tighten later if needed.
    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /weeks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /payments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /guestPayments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // set via console
    }
  }
}
