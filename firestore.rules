rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validPlayer() {
      return request.resource.data.keys().hasAll([
        'id', 'name', 'teamId', 'teamName'
      ]);
    }

    // Squad: public read for phone/username player login (no OTP).
    // Admin: full write. Anyone may update phone/email/lastUpdatedAt only
    // (player sessions are local — no Firebase Auth).
    function validSelfPhone() {
      return request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15;
    }

    function validOptionalEmail() {
      return !('email' in request.resource.data)
        || request.resource.data.email == null
        || request.resource.data.email == ''
        || (request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email.size() <= 120);
    }

    function onlyContactFields() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return (keys.hasOnly(['phone'])
          || keys.hasOnly(['email'])
          || keys.hasOnly(['phone', 'email'])
          || keys.hasOnly(['phone', 'lastUpdatedAt'])
          || keys.hasOnly(['email', 'lastUpdatedAt'])
          || keys.hasOnly(['phone', 'email', 'lastUpdatedAt']))
        && validSelfPhone()
        && validOptionalEmail();
    }

    // Player sessions are local (no Firebase Auth) — allow stamping lastLoginAt only.
    function onlyLastLoginAt() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['lastLoginAt']);
    }

    match /players/{id} {
      allow read: if true;
      allow create: if isAdmin() && validPlayer();
      allow update: if (isAdmin() && validPlayer())
        || onlyContactFields()
        || onlyLastLoginAt();
      allow delete: if isAdmin();
    }

    match /weeks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fee ledger — readable by all app users; writable by admins only.
    // Deletes must not require request.resource (null on delete) — that blocked
    // weekly/guest toggle-off and left cloud docs that reappeared after restart.
    function validFeeAmount() {
      return request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000;
    }

    match /payments/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validFeeAmount();
      allow delete: if isAdmin();
    }

    match /guestPayments/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validFeeAmount();
      allow delete: if isAdmin();
    }

    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // League schedule (CricHeroes feed source) — public read, admin write.
    match /fixtures/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trades/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.salePriceInr is int
        && request.resource.data.commissionInr is int;
      allow delete: if isAdmin();
    }

    match /appConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allow-list: set docs in Console (UID -> {}). No client writes.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
